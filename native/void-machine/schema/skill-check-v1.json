{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidcorp.io/void-machine/skill-check-v1.json",
  "title": "Void Machine skill package check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "valid", "packageId", "manifestDigest", "files", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "valid": { "type": "boolean" },
    "packageId": { "type": ["string", "null"] },
    "manifestDigest": { "type": ["string", "null"] },
    "files": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "problem", "repair"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "repair": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
