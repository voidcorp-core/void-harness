{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "packages/core/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-monorepo/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-react/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-nextjs/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-server/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-pwa/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-mobile/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/core-assets/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-monorepo/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/packs/pack-nextjs/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/harness-graph/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/core/data/certification.json",
          "jsonpath": "$.harnessVersion"
        },
        {
          "type": "json",
          "path": "packages/cli/core-assets/data/certification.json",
          "jsonpath": "$.harnessVersion"
        }
      ]
    }
  }
}
