# Changesets
# (keep the .changeset/ dir tracked, only ignore status)

# Autonomous backlog-loop run artifacts (logs, plan files, PR drafts) and
# per-ticket git worktrees. Run-scoped only — keep the rest of .void/ tracked
# (harness-feedback/, usage.log). These must stay ignored so a run's own output
# does not trip the next run's clean-tree preflight (issue #17 cluster A, A2).
.void/autonomous-runs/
.void/worktrees/
# Enriched activation telemetry log (local, runtime-only; analyzed in Phase 2).
.void/activations.jsonl
# Full tool outputs spilled by the trim-large-output hook (runtime-only pointers).
.void/outputs/
# Generated project state + history snapshots (void status; deterministic, per-project runtime).
.void/state.json
.void/history/
# Runtime outcome-recording telemetry (local, like activations.jsonl).
.void/outcomes.jsonl
# Session self-registration marker (harness writes it on start; runtime-only).
.void/.registered
.gstack/
dist-singlefile/
