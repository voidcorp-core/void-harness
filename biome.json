{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/**/src/**/*.ts",
      "packages/**/*.config.ts",
      "apps/**/src/**/*.ts",
      "apps/**/scripts/**/*.ts",
      "apps/**/*.config.ts",
      "test/**/*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/templates",
      "!**/generated",
      "!**/*.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "formatter": {
    "enabled": false
  }
}
