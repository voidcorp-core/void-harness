{
  "name": "void-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade Claude Code harness for VoidCorp. Core craftsman skills + pluggable stack packs.",
  "license": "MIT",
  "author": "Florent Pellegrin <florent.pellegrin@voidcorp.io>",
  "homepage": "https://github.com/voidcorp-core/void-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidcorp-core/void-harness.git"
  },
  "bugs": {
    "url": "https://github.com/voidcorp-core/void-harness/issues"
  },
  "scripts": {
    "build": "pnpm -r --filter '!void-harness' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "typecheck": "pnpm -r --filter '!void-harness' typecheck",
    "anti-bloat:check": "bash scripts/anti-bloat-check.sh",
    "sync:docs": "bash scripts/sync-agent-docs.sh",
    "version:check": "node scripts/check-version-lockstep.mjs",
    "check:publish": "node scripts/check-publish-safety.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/check-publish-safety.mjs && pnpm -r --filter './packages/**' publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "keywords": [
    "claude-code",
    "anthropic",
    "harness",
    "skills",
    "agents",
    "tdd",
    "tigerstyle",
    "craftsman",
    "voidcorp"
  ]
}
