{
  "name": "void-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade Claude Code harness for VoidCorp. Core craftsman skills + pluggable stack packs.",
  "license": "MIT",
  "author": "Florent Pellegrin <florent.pellegrin@voidcorp.io>",
  "homepage": "https://github.com/voidcorp-core/void-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidcorp-core/void-harness.git"
  },
  "bugs": {
    "url": "https://github.com/voidcorp-core/void-harness/issues"
  },
  "scripts": {
    "build": "pnpm -r --filter '!void-harness' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "typecheck": "pnpm -r --filter '!void-harness' typecheck",
    "anti-bloat:check": "bash scripts/anti-bloat-check.sh",
    "decisions:build": "node scripts/build-decisions-index.mjs",
    "decisions:check": "node scripts/build-decisions-index.mjs --check",
    "sync:docs": "bash scripts/sync-agent-docs.sh",
    "version:check": "node scripts/check-version-lockstep.mjs",
    "check:publish": "node scripts/check-publish-safety.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/check-publish-safety.mjs && pnpm --filter @voidfactory/harness publish",
    "certification:build": "pnpm --filter @voidcorp/harness-graph build && pnpm --filter @voidfactory/harness build:certification",
    "certification:check": "pnpm --filter @voidcorp/harness-graph build && pnpm --filter @voidfactory/harness build:certification -- --check",
    "graph:check": "pnpm --filter @voidcorp/harness-graph build && node packages/cli/bin/void-harness.mjs graph check",
    "graph:check-bundle": "node packages/cli/bin/void-harness.mjs graph check-bundle",
    "eval": "pnpm --filter @voidcorp/eval-harness run eval --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  },
  "keywords": [
    "claude-code",
    "anthropic",
    "harness",
    "skills",
    "agents",
    "tdd",
    "tigerstyle",
    "craftsman",
    "voidcorp"
  ]
}
