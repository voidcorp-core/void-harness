{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidcorp.dev/schemas/void-machine-legacy-v3.json",
  "title": "Void Machine legacy consumer oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractFamily", "contractVersion", "scenarios"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "contractFamily": { "const": "void-machine-legacy" },
    "contractVersion": { "const": 3 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "platforms", "runtimeState", "expected", "evidenceOperation"],
        "properties": {
          "id": { "type": "string", "pattern": "^(install|update|collision|rollback|receipt|doctor|runtime|skill|autopilot)\\.[a-z0-9-]+$" },
          "operation": { "enum": ["install", "update", "collision", "rollback", "receipt", "doctor", "runtime", "skill", "autopilot"] },
          "platforms": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["linux", "darwin", "win32"] } },
          "runtimeState": { "enum": ["claude-only", "codex-only", "both", "absent", "auth-ambiguous", "linked-worktree"] },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "exit", "diagnostics", "preservation", "recovery"],
            "properties": {
              "classification": { "enum": ["success", "refused", "unsupported", "unmanaged"] },
              "exit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "code"],
                "properties": {
                  "kind": { "enum": ["exited", "signaled", "timed-out", "spawn-error"] },
                  "code": { "type": ["integer", "null"], "minimum": -1, "maximum": 255 }
                }
              },
              "diagnostics": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
              "preservation": { "enum": ["not-applicable", "unchanged", "restored"] },
              "recovery": { "enum": ["clean", "resumable", "unsupported"] }
            }
          },
          "evidenceOperation": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  }
}
