{
  "name": "@voidcorp/pack-monorepo",
  "version": "1.2.0",
  "description": "Turborepo monorepo conventions for the void-harness — shared tsconfig.strict, @repo/core helpers (Result, Option, pipe), package boundary discipline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./result": {
      "import": "./dist/result.js",
      "types": "./dist/result.d.ts"
    },
    "./option": {
      "import": "./dist/option.js",
      "types": "./dist/option.d.ts"
    },
    "./pipe": {
      "import": "./dist/pipe.js",
      "types": "./dist/pipe.d.ts"
    },
    "./tsconfig.strict.json": "./tsconfig.strict.json",
    "./claude/*": "./claude/*"
  },
  "files": [
    "dist",
    "claude",
    "tsconfig.strict.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "voidcorp",
    "claude-code",
    "monorepo",
    "turborepo",
    "bun",
    "harness"
  ]
}
