{
  "name": "@voidcorp/harness",
  "version": "0.5.4",
  "description": "void-harness CLI — install the void plugin into a project, configure marketplace + settings, manage doctrine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "void-harness": "./bin/void-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "core-assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/copy-core-assets.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build && pnpm run build:assets"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0"
  }
}
