{
  "name": "@voidfactory/harness",
  "version": "0.17.0",
  "description": "void-harness CLI — install a top-5% development doctrine on any project; render deterministic project health. Command: void-harness.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "void-harness": "./bin/void-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "core-assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/copy-core-assets.mjs",
    "build:void-graph": "tsx scripts/build-void-graph.ts",
    "build:certification": "tsx scripts/build-certification.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build && pnpm run build:assets"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@voidcorp/harness-graph": "workspace:*",
    "esbuild": "^0.28.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  }
}
