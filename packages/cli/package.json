{
  "name": "@voidcorp/harness",
  "version": "0.0.0",
  "description": "Void-harness CLI — install core skills/agents/hooks into ~/.claude/voidcorp/, init a consumer project, doctor health-check.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "voidcorp-harness": "./bin/voidcorp-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "core-assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/copy-core-assets.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build && pnpm run build:assets",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
