{
  "name": "voidharness",
  "version": "2.0.2",
  "description": "void-harness CLI — install a top-5% development doctrine on any project; render deterministic project health. Run via `npx voidharness`; command: void-harness (alias vh).",
  "license": "MIT",
  "author": "Folpe @ VoidCorp",
  "homepage": "https://github.com/voidcorp-core/void-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidcorp-core/void-harness.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/voidcorp-core/void-harness/issues"
  },
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "ai-agent",
    "developer-tools",
    "code-quality",
    "tdd",
    "doctrine",
    "void-harness"
  ],
  "type": "module",
  "bin": {
    "void-harness": "./bin/void-harness.mjs",
    "vh": "./bin/void-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "core-assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/copy-core-assets.mjs",
    "build:void-graph": "tsx scripts/build-void-graph.ts",
    "build:certification": "tsx scripts/build-certification.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm --filter @voidcorp/harness-graph build && pnpm --filter @voidcorp/mission-engine build && pnpm --filter @voidcorp/hook-runner build && pnpm run build && pnpm run build:assets"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@voidcorp/harness-graph": "workspace:*",
    "@voidcorp/mission-engine": "workspace:*",
    "esbuild": "^0.28.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  }
}
