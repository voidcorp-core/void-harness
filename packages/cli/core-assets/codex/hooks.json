{
  "$comment": "Codex CLI hooks manifest — the Codex-side mirror of the Claude Code hooks wired in ../.claude-plugin/plugin.json. Both runtimes invoke the same portable Node rules; the runner normalizes Claude single-file Edit/Write and Codex multi-file apply_patch. `void-harness init` stages the runner and compiles absolute paths so sessions started in subdirectories still work. NOT mirrored, deliberately: trim-large-output, whose PostToolUse output rewriting is unconfirmed on Codex. See ../../../docs/CODEX.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce dangerous-command" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|Bash|shell",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce protected-file" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce secret-content" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce tdd-order" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce no-any" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce no-as-cast" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce no-console" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce no-null" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce no-focused-test" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce boundary-direction" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce test-name" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce design-slop" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "VOID_AGENT_RUNTIME=codex \"${VOID_HOOKS_DIR}/activation-meter.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${VOID_HOOKS_DIR}/auto-format.sh\"" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "VOID_AGENT_RUNTIME=codex \"${VOID_HOOKS_DIR}/outcome-meter.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${VOID_HOOKS_DIR}/sessionstart-context.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "VOID_AGENT_RUNTIME=codex \"${VOID_HOOKS_DIR}/outcome-meter.sh\"" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "\"${VOID_HOOKS_DIR}/stop-typecheck.sh\"" }
        ]
      }
    ]
  }
}
