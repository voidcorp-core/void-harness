{
  "name": "@voidcorp/void-machine",
  "version": "0.0.0",
  "private": true,
  "description": "Layered TypeScript implementation of retained Void Machine capabilities.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/application/doctor.js",
  "types": "./dist/application/doctor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/application/doctor.d.ts",
      "import": "./dist/application/doctor.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.tests.json --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
